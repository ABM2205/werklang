#!/usr/bin/env werk
import (
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"sync"
)

config app {
	/// Output binary name
	name: String = "werk"

	/// Output directory for local builds
	outDir: String = "bin"

	/// Strip symbols for release builds
	release: Boolean = false

	paths {
		grammarDir = "tree-sitter-werklang"
		zedDir = "extensions/zed"
	}
}

binPath := filepath.Join(app.OutDir, app.Name)

func runCmd(dir string, name string, args ...string) error {
	cmd := exec.Command(name, args...)
	cmd.Dir = dir
	cmd.Stdout = os.Stdout
	cmd.Stderr = os.Stderr
	return cmd.Run()
}

func mustRun(dir string, name string, args ...string) {
	if err := runCmd(dir, name, args...); err != nil {
		fmt.Fprintf(os.Stderr, "%s %v failed: %v\n", name, args, err)
		os.Exit(1)
	}
}

func taskBuild() {
	if err := os.MkdirAll(app.OutDir, 0o755); err != nil {
		panic(err)
	}
	args := []string{"build"}
	if app.Release {
		args = append(args, "-ldflags", "-s -w")
	}
	args = append(args, "-o", binPath, ".")
	mustRun(".", "go", args...)
	fmt.Printf("Built %s\n", binPath)
}

func taskTest() {
	mustRun(".", "go", "test", "./...")
}

func taskGrammar() {
	mustRun(app.Paths.GrammarDir, "tree-sitter", "generate")
	mustRun(app.Paths.GrammarDir, "tree-sitter", "test")
}

func taskZed() {
	mustRun(app.Paths.ZedDir, "cargo", "check")
}

func taskCheck() {
	tasks := []struct {
		name string
		fn   func() error
	}{
		{"test", func() error { return runCmd(".", "go", "test", "./...") }},
		{"grammar", func() error {
			if err := runCmd(app.Paths.GrammarDir, "tree-sitter", "generate"); err != nil {
				return err
			}
			return runCmd(app.Paths.GrammarDir, "tree-sitter", "test")
		}},
		{"zed", func() error { return runCmd(app.Paths.ZedDir, "cargo", "check") }},
	}

	var wg sync.WaitGroup
	errs := make(chan error, len(tasks))
	for _, t := range tasks {
		wg.Add(1)
		go func(name string, fn func() error) {
			defer wg.Done()
			if err := fn(); err != nil {
				errs <- fmt.Errorf("%s: %w", name, err)
			}
		}(t.name, t.fn)
	}
	wg.Wait()
	close(errs)
	for err := range errs {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println("All checks passed.")
}

func taskInstall() {
	installDir := os.Getenv("GOBIN")
	if installDir == "" {
		home, err := os.UserHomeDir()
		if err != nil {
			panic(err)
		}
		installDir = filepath.Join(home, ".local", "bin")
	}
	if err := os.MkdirAll(installDir, 0o755); err != nil {
		panic(err)
	}
	out := filepath.Join(installDir, app.Name)
	mustRun(".", "go", "build", "-o", out, ".")
	fmt.Printf("Installed %s\n", out)
}

func taskClean() {
	_ = os.RemoveAll(app.OutDir)
}

task := "build"
if len(os.Args) > 1 {
	task = os.Args[1]
}

switch task {
case "build":
	taskBuild()
case "test":
	taskTest()
case "grammar":
	taskGrammar()
case "zed":
	taskZed()
case "check":
	taskCheck()
case "install":
	taskInstall()
case "clean":
	taskClean()
default:
	fmt.Fprintf(os.Stderr, "unknown task %q (available: build, test, grammar, zed, check, install, clean)\n", task)
	os.Exit(1)
}

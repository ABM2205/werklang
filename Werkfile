#!/usr/bin/env werk
import (
	"bytes"
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"sync"
	"time"
)

config app {
	/// Output binary name
	name: String = "werk"

	/// Output directory for local builds
	outDir: String = "bin"

	/// Local binary output path
	bin: String = "\(outDir)/\(name)"

	/// Strip debug symbols for release builds
	release: Boolean = false

	/// Linker flags derived from release setting
	ldflags: String = if (release) "-s -w" else ""

	/// Optional release version for the changelog task
	changelogVersion: String = ""

	/// Optional agent CLI binary override for the changelog task
	agentBin: String = ""

	paths {
		grammarDir = "tree-sitter-werklang"
		zedDir = "extensions/zed"
	}
}

type taskSpec struct {
	name string
	desc string
	fn   func(args []string)
}

func runCmd(dir string, name string, args ...string) error {
	cmd := exec.Command(name, args...)
	cmd.Dir = dir
	cmd.Stdout = os.Stdout
	cmd.Stderr = os.Stderr
	return cmd.Run()
}

func runBuffered(dir string, name string, args ...string) (string, error) {
	var buf bytes.Buffer
	cmd := exec.Command(name, args...)
	cmd.Dir = dir
	cmd.Stdout = &buf
	cmd.Stderr = &buf
	err := cmd.Run()
	return buf.String(), err
}

func mustRun(dir string, name string, args ...string) {
	if err := runCmd(dir, name, args...); err != nil {
		fmt.Fprintf(os.Stderr, "%s %v failed: %v\n", name, args, err)
		os.Exit(1)
	}
}

func capture(name string, args ...string) (string, error) {
	out, err := exec.Command(name, args...).Output()
	return strings.TrimSpace(string(out)), err
}

func runParallel(steps []struct {
	name string
	fn   func() (string, error)
}) {
	var wg sync.WaitGroup
	type stepResult struct {
		name string
		out  string
		err  error
	}
	results := make([]stepResult, len(steps))
	for i, step := range steps {
		wg.Add(1)
		go func(idx int, name string, fn func() (string, error)) {
			defer wg.Done()
			out, err := fn()
			results[idx] = stepResult{name: name, out: out, err: err}
		}(i, step.name, step.fn)
	}
	wg.Wait()

	failed := false
	for _, r := range results {
		if r.err != nil {
			failed = true
			fmt.Fprintf(os.Stderr, "=== %s failed ===\n%s\n%v\n", r.name, strings.TrimSpace(r.out), r.err)
		}
	}
	if failed {
		os.Exit(1)
	}
}

func taskBuild(args []string) {
	fast := false
	for _, a := range args {
		if a == "--fast" {
			fast = true
		}
	}
	if !fast {
		runParallel([]struct {
			name string
			fn   func() (string, error)
		}{
			{"test", func() (string, error) { return runBuffered(".", "go", "test", "./...") }},
			{"grammar", func() (string, error) {
				if out, err := runBuffered(app.Paths.GrammarDir, "tree-sitter", "generate"); err != nil {
					return out, err
				}
				return runBuffered(app.Paths.GrammarDir, "tree-sitter", "test")
			}},
		})
	}

	if err := os.MkdirAll(app.OutDir, 0o755); err != nil {
		fmt.Fprintf(os.Stderr, "mkdir %s: %v\n", app.OutDir, err)
		os.Exit(1)
	}
	buildArgs := []string{"build"}
	if app.Ldflags != "" {
		buildArgs = append(buildArgs, "-ldflags", app.Ldflags)
	}
	buildArgs = append(buildArgs, "-o", app.Bin, ".")
	mustRun(".", "go", buildArgs...)
	fmt.Printf("Built %s\n", app.Bin)
}

func taskTest(_ []string) {
	mustRun(".", "go", "test", "./...")
}

func taskGrammar(_ []string) {
	mustRun(app.Paths.GrammarDir, "tree-sitter", "generate")
	mustRun(app.Paths.GrammarDir, "tree-sitter", "test")
}

func taskZed(_ []string) {
	mustRun(app.Paths.ZedDir, "cargo", "check")
}

func taskCheck(_ []string) {
	runParallel([]struct {
		name string
		fn   func() (string, error)
	}{
		{"test", func() (string, error) { return runBuffered(".", "go", "test", "./...") }},
		{"grammar", func() (string, error) {
			if out, err := runBuffered(app.Paths.GrammarDir, "tree-sitter", "generate"); err != nil {
				return out, err
			}
			return runBuffered(app.Paths.GrammarDir, "tree-sitter", "test")
		}},
		{"zed", func() (string, error) { return runBuffered(app.Paths.ZedDir, "cargo", "check") }},
	})
	fmt.Println("All checks passed.")
}

func taskInstall(_ []string) {
	installDir := os.Getenv("GOBIN")
	if installDir == "" {
		home, err := os.UserHomeDir()
		if err != nil {
			fmt.Fprintf(os.Stderr, "resolve home dir: %v\n", err)
			os.Exit(1)
		}
		installDir = filepath.Join(home, ".local", "bin")
	}
	if err := os.MkdirAll(installDir, 0o755); err != nil {
		fmt.Fprintf(os.Stderr, "mkdir %s: %v\n", installDir, err)
		os.Exit(1)
	}
	out := filepath.Join(installDir, app.Name)
	buildArgs := []string{"build"}
	if app.Ldflags != "" {
		buildArgs = append(buildArgs, "-ldflags", app.Ldflags)
	}
	buildArgs = append(buildArgs, "-o", out, ".")
	mustRun(".", "go", buildArgs...)
	fmt.Printf("Installed %s\n", out)
}

func taskChangelog(args []string) {
	ver := app.ChangelogVersion
	if envVer := os.Getenv("WERK_CHANGELOG_VERSION"); envVer != "" {
		ver = envVer
	}
	resolvedAgent := app.AgentBin
	if envAgent := os.Getenv("WERK_AGENT_BIN"); envAgent != "" {
		resolvedAgent = envAgent
	}
	for i := 0; i < len(args); i++ {
		switch {
		case (args[i] == "--version" || args[i] == "-v") && i+1 < len(args):
			ver = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--version="):
			ver = strings.TrimPrefix(args[i], "--version=")
		case args[i] == "--agent" && i+1 < len(args):
			resolvedAgent = args[i+1]
			i++
		case strings.HasPrefix(args[i], "--agent="):
			resolvedAgent = strings.TrimPrefix(args[i], "--agent=")
		}
	}

	if resolvedAgent == "" {
		if p, err := exec.LookPath("agy"); err == nil {
			resolvedAgent = p
		} else if home, hErr := os.UserHomeDir(); hErr == nil {
			localAgy := filepath.Join(home, ".local", "bin", "agy")
			if st, sErr := os.Stat(localAgy); sErr == nil && !st.IsDir() {
				resolvedAgent = localAgy
			}
		}
	}
	if resolvedAgent == "" {
		fmt.Fprintln(os.Stderr, "agent CLI 'agy' not found; install agy or set WERK_AGENT_BIN=<cli>")
		os.Exit(1)
	}

	today := time.Now().Format("2006-01-02")
	rawRemote, _ := capture("git", "remote", "get-url", "origin")
	trimmedRemote := strings.TrimSuffix(strings.TrimSpace(rawRemote), ".git")
	repoURL := trimmedRemote
	if strings.HasPrefix(trimmedRemote, "git@github.com:") {
		repoURL = "https://github.com/" + strings.TrimPrefix(trimmedRemote, "git@github.com:")
	}

	latestTag, tagErr := capture("git", "describe", "--tags", "--abbrev=0")
	var commits string
	if tagErr == nil && latestTag != "" {
		commits, _ = capture("git", "log", latestTag+"..HEAD", "--pretty=format:- %h (%cs) %s")
	} else {
		latestTag = "(none)"
		commits, _ = capture("git", "log", "-n", "50", "--pretty=format:- %h (%cs) %s")
	}
	worktreeStatus, _ := capture("git", "status", "--short")

	ver = strings.TrimPrefix(strings.TrimSpace(ver), "v")
	releaseRule := "Place all unreleased commits and working-tree changes under '## [Unreleased]', preserving all existing released version sections verbatim."
	if ver != "" {
		releaseRule = fmt.Sprintf("Cut release '## [%s] - %s' right below an empty '## [Unreleased]' section, moving unreleased entries into '[%s]' and updating bottom comparison links.", ver, today, ver)
	}

	prompt := fmt.Sprintf(`Create or update CHANGELOG.md in the repository root strictly following Keep a Changelog v1.1.0 (https://keepachangelog.com/en/1.1.0/).

Requirements:
1. Header: Start with '# Changelog', state that all notable changes to this project will be documented in this file, and link Keep a Changelog (https://keepachangelog.com/en/1.1.0/) and Semantic Versioning (https://semver.org/spec/v2.0.0.html).
2. Human-focused entries: Write clear, concise, user-facing bullet points grouping related work—do not dump raw git commit messages.
3. Structure & Sections:
   - Keep '## [Unreleased]' at the top.
   - Order released versions newest-first using ISO 8601 dates ('## [X.Y.Z] - YYYY-MM-DD').
   - Group entries strictly under standard Keep a Changelog subsections (include only non-empty ones, in this order):
     ### Added
     ### Changed
     ### Deprecated
     ### Removed
     ### Fixed
     ### Security
4. Release handling: %s
5. Reference links: Maintain Markdown reference-style comparison/tag links at the bottom using repository URL: %s
6. Read existing CHANGELOG.md if present, inspect key project files for accurate feature descriptions if needed, and write CHANGELOG.md directly.

Repository Git Context (as of %s):
- Remote: %s
- Latest tag: %s
- Commits:
%s

- Working tree status:
%s
`, releaseRule, repoURL, today, repoURL, latestTag, commits, worktreeStatus)

	fmt.Printf("Spawning %s to update CHANGELOG.md...\n", filepath.Base(resolvedAgent))
	if filepath.Base(resolvedAgent) == "agy" {
		mustRun(".", resolvedAgent, "--mode", "accept-edits", "--print", prompt)
	} else {
		mustRun(".", resolvedAgent, "-p", prompt)
	}
}

func taskClean(_ []string) {
	_ = os.RemoveAll(app.OutDir)
	fmt.Printf("Removed %s\n", app.OutDir)
}

tasks := []taskSpec{
	{"build", "Run Go & grammar checks and build bin/werk (pass --fast to skip checks)", taskBuild},
	{"test", "Run Go compiler, Pkl schema, runner, and LSP tests", taskTest},
	{"grammar", "Generate and test the Tree-sitter grammar", taskGrammar},
	{"zed", "Typecheck the Zed Rust WASM extension", taskZed},
	{"check", "Run Go, Tree-sitter, and Zed checks in parallel", taskCheck},
	{"install", "Install werk into ~/.local/bin (or $GOBIN)", taskInstall},
	{"changelog", "Spawn an AI agent to update CHANGELOG.md (Keep a Changelog 1.1.0)", taskChangelog},
	{"clean", "Remove compiled build artifacts", taskClean},
}

func printTasks() {
	fmt.Println("Usage: ./Werkfile [task] [args...]  (or: werk [task] [args...])")
	fmt.Println("\nTasks:")
	for _, t := range tasks {
		fmt.Printf("  %-12s %s\n", t.name, t.desc)
	}
}

selected := "build"
var taskArgs []string
if len(os.Args) > 1 {
	selected = os.Args[1]
	taskArgs = os.Args[2:]
}
if selected == "help" || selected == "list" || selected == "-h" || selected == "--help" {
	printTasks()
	os.Exit(0)
}
found := false
for _, t := range tasks {
	if t.name == selected {
		found = true
		t.fn(taskArgs)
		break
	}
}
if !found {
	fmt.Fprintf(os.Stderr, "unknown task %q\n\n", selected)
	printTasks()
	os.Exit(1)
}
